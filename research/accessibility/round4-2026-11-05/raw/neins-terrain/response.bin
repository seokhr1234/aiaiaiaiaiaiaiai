<style>

/* 
	.more {display:block;width: 120px;height: 16px;background-image:url('/assets/images/img/lnb_open1.png');margin-left:178px;border-top : 1px solid #666666;} 
	.close {display:block;background-image:url('/assets/images/img/lnb_close1.png');width: 120px;height: 16px;margin-left:178px;}
*/
.more {display: block;width: 100%;height: 18px;background: url('/assets/images/img/lnb_open1.png') no-repeat 50%;border-top: 1px solid #C4C4C4;cursor: pointer;}
.close{display: block;width: 100%;height: 18px;background: url('/assets/images/img/lnb_close1.png') no-repeat 50%;border-top: 1px solid #C4C4C4;cursor: pointer}

.blind {position: absolute;overflow: hidden;clip: rect(0 0 0 0);margin: -1px;width: 1px;height: 1px;}
.more:hover, .close:hover {cursor:pointer;}
.board {font-family:'돋움';font-size:13px;position:absolute;top:30px;width:410px;height:135px;background:pink;visibility:hidden;}
.list {float:left;}
.list li {list-style:none;margin-top:5px;}
.list li:hover {text-decoration:underline;cursor:pointer;}
#main_right_tools{position:absolute; top:34.8em; right:0.7em; z-index:9; font-size:13px;transition:all 0.3s ease; -webkit-transition:all 0.3s ease;}
#main_right_tools .map_ctrl1{text-align:right;}
#main_right_tools .map_ctrl1 .map_op{overflow:hidden; position:relative; display:block; width:2.875em; height:2.875em; line-height:2.875em; background-color:#fff; border-radius:0.2em; text-align:center; box-shadow:2px 2px 5px rgba(0,0,0,0.2);transition:width 0.3s ease; -webkit-transition:width 0.3s ease;}
#main_right_tools .map_ctrl1 .map_op:hover{width:14.4em;}
#main_right_tools .map_ctrl1 .map_op a{position:absolute; top:0; display:block; width:2.875em;}
#main_right_tools .map_ctrl1 .map_op a:after{content:""; position:absolute; top:calc(50% - 1.3em); right:-1px; width:1px; height:2.6em; background-color:#E7E7E7;}
#main_right_tools .map_ctrl1 .map_op .map_btn{left:0; display:none;color:black;}
#main_right_tools .map_ctrl1 .map_op .sky_btn{left:2.875em;}
#main_right_tools .map_ctrl1 .map_op .night_btn{left:5.75em;}
#main_right_tools .map_ctrl1 .map_op .gray_btn{left:8.625em;}
#main_right_tools .map_ctrl1 .map_op .osm_btn{left:11.5em;}
#main_right_tools .map_ctrl1 .map_op[data-option="map"]:hover .map_btn{color:#005DB7;}
#main_right_tools .map_ctrl1 .map_op[data-option="sky"]:hover .sky_btn{color:#005DB7;}
#main_right_tools .map_ctrl1 .map_op[data-option="gray"]:hover .gray_btn{color:#005DB7;}
#main_right_tools .map_ctrl1 .map_op[data-option="night"]:hover .night_btn{color:#005DB7;}
@media screen and (max-width:1024px){
	#main_right_tools{font-size:15px;}
}
@media screen and (max-width:920px){
	#main_right_tools{font-size:13px;}
}
@media screen and (max-width:740px){
	#main_right_tools{top:5.5em;}
}
</style>
