<script>
	var db_x, db_y;
	var o;
	var format = new ol.format.WKT();
	var parser = new jsts.io.OL3Parser();
	var ecvamNeinsDomain = 'https://ecvam.neins.go.kr';
	//지번검색 분석에 대한 알림창 팝업
	var Alert = {
		confirm : function(msg, fn1, fn2) {
			$('#mapAlert')
					.html(
							'<table><tr valign="top"><td style="width:30px;"><span class="ui-icon ui-icon-circle-check" style="float: left; margin: 3px 7px 50px 0;"></span></td><td><p>'
									+ msg + '</p></td></tr></table>').dialog({
						title : '알림',
						modal : true,
						position : {
							my : "center",
							at : "center",
							of : window
						},
						close : function() {
							$(this).dialog('close');
						},
						buttons : {
							/*
							'1:25,000' : function() {
								$(this).dialog('close');
								if (fn1 && typeof (fn1) == "function") {
									fn1();
								}
							},
							*/
							'1:5,000' : function() {
								$(this).dialog('close');
								if (fn2 && typeof (fn2) == "function") {
									fn2();
								}
							}
						}
					});
		}
	};
	
	/* 민원발생지역 선택 모드 */
	let selectMode = false;
	
	$(document).ready(function(){
		if(typeof navigator.platform.toLowerCase==='function' && typeof window.matchMedia==='function'){
			var filter = "win16|win32|win64|macintel|mac|";
			var isMobile = false;
			if(filter.indexOf(navigator.platform.toLowerCase()) < 0){
				isMobile = true;
			}
			if(isMobile){
				var isDesktopMode = window.matchMedia("(max-width: "+mediaMatchMedia+"px)").matches;
				if (isDesktopMode) {
					location.href = mobileDomain;
					//location.href = "https://mwebgis.neins.go.kr/";
				}
			}		
		}
		
		const vectorSource = new ol.source.Vector({
	       features: []
	    });
	    
	    const vectorLayer = new ol.layer.Vector({
	       source: vectorSource,
	       id: "opinionLayer",
	       title: "opinionLayer",
	       style: new ol.style.Style({
	          stroke: new ol.style.Stroke({
	             color: 'rgba(255,0,0,1)',
	             width: 2
	          }),
	          fill: new ol.style.Fill({
	             color: 'rgba(255,0,0,0.2)'
	          })
	       })
	    });
	    
	    map.addLayer(vectorLayer);
	    
	});	
	//창 크기 변경시 사이즈 조절
	$(window).resize(function() {
		windowResize('sampleMap');
	});
	/* 20211001 수정
	*  url ? 뒤에 아무것도없을때 그린면적 삭제가 안되는 오류 조치
	*  compareUrl 초기할당
	*/
	function showMapInfoDiv(){
		$('.mapInfoDiv').css('display','block');
		return '맵 위치정보를 활성화 하였습니다.';
	}
	
	$(document).ready(function() {
		//토지이용 규제정보 용
		//o = jindoSetting('cada','o');
		//환경입지분석 용
		o = jindoSetting('envLoc','o');
		evl = jindoEvlSetting('evlcl', 'evl')
		//맵의 현재 view 정보를 확인하는 함수
		map.on('moveend', function(){
			const mapView = map.getView();
			const mapLocationValue = {
					//'size' : map.getSize(),
					'zoom' : mapView.getZoom(),
					'extent' : mapView.calculateExtent(map.getSize())
			}
			const extentKey = ['minX','minY','maxX','maxY'];
			var html = '';
			for(var i=0; i<5; i++){
				html +='<span>';
				if(i==4){
					html +='zoom레벨 : '+ mapLocationValue.zoom;
					html +='</span>';				
				}else{
					html +=extentKey[i]+' : '+ mapLocationValue.extent[i];
					html +='</span></br>';
				}
			}
			$('.mapInfoDiv div').html(html);
		});
		
		/* 민원 발생지역 세부내역 확인 */
/* 		map.on("singleclick", e => {
			if (!selectMode) return;
			
			map.forEachFeatureAtPixel(e.pixel, (feature, layer) => {

				if(layer.get("id") !== "opinionAndQnaLayer"){
					return;
				}
				console.log(feature.getProperties())
				$(".opinion_popup .tit span").html(feature.getProperties().cvlcpt_addr_content);
				//$(".opinion_popup .opinion_se span").html(feature.getProperties().cvlcpt_se_cd === "CV001" ? "문의사항" : "의견보내기");
				$(".opinion_popup .opinion_se span").html(feature.getProperties().name);
				$(".opinion_popup .opinion_title span").html(feature.getProperties().title);
				$(".opinion_popup .opinion_date span").html(feature.getProperties().date);
				
				$(".opinion_popup #opinion_se_cd").val(feature.getProperties().cvlcpt_se_cd);
				$(".opinion_popup #opinion_seq").val(feature.getProperties().cvlcpt_seq);
				
				$(".opinion_popup").width(263);
				do {
					$(".rclick_layer").width($(".rclick_layer").width()+1);
				} while ($(".rclick_layer .tit span").height() > $(".rclick_layer .tit").height());
				
				
				let opinionPopupLeft = Math.round(e.pixel[0]) + 10;
				let opinionPopupTop = Math.round(e.pixel[1]) + Math.round($(".opinion_popup").height()/2);
				$(".opinion_popup").css({
					"left" : (opinionPopupLeft + $(".opinion_popup").width() > $(".ol-viewport").width() ? ((opinionPopupLeft-$(".opinion_popup").width()-50)+"px") : opinionPopupLeft + "px"),
					"top" : (opinionPopupTop + $(".opinion_popup").height() > $(".ol-viewport").height() ? ((opinionPopupTop-$(".opinion_popup").height()-50)+"px") : opinionPopupTop + "px")
				}).show();
				
			
			})
		}) */

		map.on("singleclick", e => {
		    if (!selectMode) return;
		 	// 비우기
		 	let seq = 1; // 순번
	        $("#opinionTable tbody").empty();
		    map.forEachFeatureAtPixel(e.pixel, (feature, layer) => {

		        if(layer.get("id") !== "opinionAndQnaLayer") return;

		        const props = feature.getProperties();

		        // 주소
		        $(".opinion_popup .tit span").html(props.cvlcpt_addr_content);
		        
		        let displayTitle = props.title;
		        if(displayTitle.length > 12){
		            displayTitle = displayTitle.substring(0, 12) + '...';
		        }
		        
		        const tr = document.createElement("tr");
		        tr.innerHTML =
		            '<td style="text-align:center; vertical-align:middle; width:7%; border:1px solid #ccc; height:30px;">' + seq + '</td>' +
		            '<td style="text-align:center; vertical-align:middle; width:40%; border:1px solid #ccc; height:30px;" colspan="1">' + displayTitle + '</td>' +
		            '<td style="text-align:center; vertical-align:middle; width:20%; border:1px solid #ccc; height:30px;" colspan="1">' + props.date + '</td>' +
		            '<td style="text-align:center; vertical-align:middle; width:13%; border:1px solid #ccc; height:30px;" colspan="1">' + props.name + '</td>' +
		            '<td style="text-align:center; vertical-align:middle; width:20%; border:1px solid #ccc; height:30px;" colspan="1">' +
		            '<button style="padding:2px 6px; font-size:11px; border:1px solid #EAEAEA; border-radius:5px; background-color:#EFEFEF; cursor:pointer;" ' +
		            'onclick="moveParentPage(\'' + props.cvlcpt_se_cd + '\', \'' + props.cvlcpt_seq + '\')">' +
		            '민원상세 이동</button></td>';
		            
		        document.querySelector("#opinionTable tbody").appendChild(tr);
		        seq++; // 순번 증가

		        $(".opinion_popup #opinion_se_cd").val(props.cvlcpt_se_cd);
		        $(".opinion_popup #opinion_seq").val(props.cvlcpt_seq);

		        $(".opinion_popup").width(410);
		        do {
		            $(".rclick_layer").width($(".rclick_layer").width()+1);
		        } while ($(".rclick_layer .tit span").height() > $(".rclick_layer .tit").height());

		        let opinionPopupLeft = Math.round(e.pixel[0]) + 10;
		        let opinionPopupTop = Math.round(e.pixel[1]) + Math.round($(".opinion_popup").height()/2);
		        $(".opinion_popup").css({
		            "left" : (opinionPopupLeft + $(".opinion_popup").width() > $(".ol-viewport").width() ? ((opinionPopupLeft-$(".opinion_popup").width()-50)+"px") : opinionPopupLeft + "px"),
		            "top" : (opinionPopupTop + $(".opinion_popup").height() > $(".ol-viewport").height() ? ((opinionPopupTop-$(".opinion_popup").height()-50)+"px") : opinionPopupTop + "px")
		        }).show();
		    });
		 	
		});

		
		//warnInfoPopup끄기
		warnInfoPopupOff();
		$('.more').click(function(){
			if($('.more').hasClass('more')){
				$('.more').addClass('close').removeClass('more');
				$('.popup_layer').css('height', 'calc(100% - 134px)');
				$('.popup_cnt').css('height', '406px');
				$('.close').attr('title', '레이어 선택 보기창 접기');
			}else if($('.close').hasClass('close')){
				$('.close').addClass('more').removeClass('close');  
				$('.popup_layer').css('height', '471px');
				$('.popup_cnt').css('height', '282px');
				$('.more').attr('title', '레이어 선택 보기창 펼치기');
			}
		});
		var readInUrl = window.location.search;
		
		//wms호출
		if(readInUrl == '?wmsCall'){
			readInUrl="";
		}else if(readInUrl == '?EVLCL'){ //EVLCL로 접속했을때
			readInUrl="";
			$('#lnb .mnb_list li:eq(5)').css({'display' : 'block'}) //평가분류지원 아이콘 block
