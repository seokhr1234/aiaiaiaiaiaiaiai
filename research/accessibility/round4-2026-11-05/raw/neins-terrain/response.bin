	$(document).on('click', '.move-btn', function () {
      const uid = parseFloat($(this).data('uid'));
      if (!this.dataset.uid || isNaN(uid)) {
         console.warn('moveToMap 호출 생략: uid 없음', this);
         return;
      }
      moveToMap(uid);
      });
	});

	
	//토지이용규제 shp업로드실행
	//환경입지분석 shp업로드실행
	function upload(analType) {
		var jindo;
		jindo = o;
		if (jindo.getInfo().count.load != 4) {
			if (jindo.getInfo().count.total == 0) {
				alert("shp이 선택되지 않았습니다.");
				return;
			}
			if (jindo.getInfo().count.total < 4) {
				alert("*.shp, *.dbf, *.prj, *.shx 파일 모두 업로드 하시기 바랍니다.");
				return;
			}
			if (jindo.getInfo().count.total > 4) {
				alert("최대 4개 파일까지만 가능합니다.");
				jindo.remove();
				return;
			}
			var fileNm = createFileNm();
			$("#frmShp #shpFileName").val(fileNm);
			jindo._url = '/fileUpload/analysisShpUpload.ajax?type=left&strFileNm=' + fileNm;
			jindo.upload();
		} else {
			alert("버퍼설정을 바꾸려면 shp파일을 재업로드 해야합니다.");
			jindo.remove();
			//$(".buffer_box input:eq(1)").val("0");
		}
	}

	//토지이용규제 shp 분석처리
	function analysisToShp() {
		//로딩중 열기 - loadingBar 변경 20200203
		/* $(".detail_load_box").show(); */
		EasyLoading.show({
			type : EasyLoading.TYPE['BALL_SCALE_RIPPLE_MULTIPLE'],
			text : 'loading'
		});
		var layer = getLayerById(map, "landUseFeature");
		layer.getSource().clear();
		layer.setVisible(true);
		var opaVal = $("#shpOpacity").val(); 
		opaVal = Number(opaVal);
		layer.setOpacity(opaVal); // 버퍼 투명도

		var coordinateList = $("#frmShp #shpCoordinate").val().split("|");
		createLandUseLayerFeature(layer, coordinateList);
		map.getView().fit(layer.getSource().getExtent());

		//분석 로그
		var resultCode = insertGisLog("LM004", 'LF011', '');
		if (resultCode == 'success') {
			//분석
			var url = proxyUrl + rasterAnalysisLandUseUrl;
			var params = $('#frmShp').serialize();
			fnAjaxAsync(url, params, "json", function(result) {
				if (result.info.resultTotal > 0) {
					var resultCount = $(".analy_result_list:eq(1)").siblings()
							.find("span");
					var resultList = $(".analy_result_list:eq(1)");

					createLandUseAnalysisList(result.info.resultList,
							resultList, resultCount);
				} else {
					var resultCount = $(".analy_result_list:eq(1)").siblings()
							.find("span").text("0");
					var resultList = $(".analy_result_list:eq(1)").empty()
							.append("검색결과가 없습니다.");
				}
				//로딩중 닫기
				/* $(".detail_load_box").hide(); */
				EasyLoading.hide();
			}, error);
		}
	}
	//토지이용규제 레이어 온오프
	function landUseLayerOnOff(obj) {
		var layerNm = obj.value;
		var onOff = obj.checked;

		getLayerById(map, layerNm).setVisible(onOff);//레이어 off
	}
	//토지이용규제 지적 분석처리
	function analysisToCadastral() {
		var coordinateList = $("#frmCadastral #cadaOriginalCoordinate").val().split("|");
		if(coordinateList == null || coordinateList == '') {
			alert('선택된 지적이 없습니다.')
			return
		}
		//로딩중 열기 - loadingBar 변경 20200203
		/* $(".detail_load_box").show(); */
		EasyLoading.show({
			type : EasyLoading.TYPE['BALL_SCALE_RIPPLE_MULTIPLE'],
			text : 'loading'
		});
		//원본 지적 피쳐생성
		var layer = getLayerById(map, "landUseFeature2");
		layer.getSource().clear();
		layer.setVisible(true);
		createLandUseLayerFeature(layer, coordinateList);

		layer = getLayerById(map, "landUseFeature");
		layer.getSource().clear();
		layer.setVisible(true);
		// 버퍼 투명도
		/* var opaVal = $("#cadastralOpacity").val().replace("%", "");
		opaVal = Number(opaVal)/100; */
		layer.setOpacity($("#cadastralOpacity").val());

		var geomString = "";
		var bufferValue = $(".buffer_box input:eq(0)").val();
		var geomString = createBufferCoordinate(coordinateList, bufferValue, true);
		createLandUseLayerFeature(layer, geomString.split("|"));

		map.getView().fit(layer.getSource().getExtent());
		$("#frmCadastral #cadaCoordinate").val(geomString);

		//분석 로그
		var resultCode = insertGisLog("LM004", 'LF012', '');
		if (resultCode == 'success') {
			//분석
			var url = proxyUrl + rasterAnalysisLandUseUrl;
			var params = $('#frmCadastral').serialize();

			fnAjaxAsync(url, params, "json", function(result) {
				if (result.info.resultTotal > 0) {
					var resultCount = $(".analy_result_list:eq(0)").siblings()
							.find("span");
					var resultList = $(".analy_result_list:eq(0)");

					createLandUseAnalysisList(result.info.resultList,
							resultList, resultCount);
				} else {
					var resultCount = $(".analy_result_list:eq(0)").siblings()
							.find("span").text("0");
					var resultList = $(".analy_result_list:eq(0)").empty()
							.append("검색결과가 없습니다.");
				}
				//로딩중 닫기
				/* $(".detail_load_box").hide(); */
				EasyLoading.hide();
			}, error);
		}

	}

	// 토지이용계획 화면 호출
	function fnLuris() {
		var url = "http://www.eum.go.kr/web/ar/lu/luLandDet.jsp?";
		url += "&mode=search&sMode=search&selGbn=umd&isNoScr=script&&flag=";
		url += "&pnu=" + lPnu;
		url += "&selSido=" + lSelSido;
		url += "&selSgg=" + lSelSgg;
		url += "&selUmd=" + lSelUmd;
		url += "&selRi=" + lSelRi;
		url += "&landGbn=" + lLandGbn;
		url += "&bobn=" + lBobn;
		url += "&bubn=" + lBubn;

		window
				.open(url, "_blank",
						"width=800, height=900, toolbar=no, menubar=no, scrollbars=yes, resizable=yes");
		initRightClickPopup();
		return false;

	}
	// 도시계획 열람 서비스 화면 호출
	function fnLup(url) {
		url += "?&mode=search&sMode=search&selGbn=umd&isNoScr=script&&flag=";
		url += "&pnu=" + lPnu;
		url += "&selSido=" + lSelSido;
		url += "&selSgg=" + lSelSgg;
		url += "&selUmd=" + lSelUmd;
		url += "&selRi=" + lSelRi;
		url += "&landGbn=" + lLandGbn;
		url += "&bobn=" + lBobn;
		url += "&bubn=" + lBubn;

        window.open(url, '_blank', 'width=800, height=900, toolbar=no, menubar=no, scrollbars=yes, resizable=yes');
    }

	// 임시 벡터 피처 분석
	function fnAnalysisTempFeature(gbn, kind) {
		var geomStringSplit = [];
		var geomStringSplitResult = [];
		// tempFeature :: customSingleMap.js 202 Line Number >> 변수 지정
		var geom = tempFeature.getGeometry();			// 피처에서 지오메트리 가져오기
		
		var format = new ol.format.WKT();				// wkt포맷 선언
		var geomString =  format.writeGeometry(geom);	// 지오메트리 wkt형식으로 변환
			geomStringSplit = geomString.split("),(");
			geomStringSplitResult.push(geomStringSplit[0]+"))");
			for(var i=1;i<geomStringSplit.length;i++){
				if(i<geomStringSplit.length){
					geomStringSplitResult.push("POLYGON(("+geomStringSplit[i]+"))");
				}
			}
			
		$("#analysisFrm #analCoordinate").val(geomStringSplitResult[$("#tfSelect").val()]);// 좌표정보
		$("#analysisFrm #analFeatureType").val(geom.getType());// 피처타입
		$("#analysisFrm #analEpsgCd").val("EPSG:3857");// 좌표계
		$("#analysisFrm #analScaleValue").val(nowScaleValue);// 축척
		
		if(gbn=='gh') {	// 경사도/고도
			$("#analysisFrm #analGhDivision").val(kind);
			$("#analysisFrm #analAnalysisType").val(kind);
			$("#analysisFrm #analAnalysisType").val("draw");
			$("#analysisFrm  #analLayerAnalysisGroupCd").val(nowScaleValue=="25000"? "AG001" : "AG003");// 레이어
			$("#analysisFrm").attr("action",  "/popup/ghAnalysisDrawPopup.do");
		}else{ // 국토환경성평가
			$("#analysisFrm #analAnalysisType").val("draw");
			/* $("#analysisFrm #layerAnalysisGroupCd").val(nowScaleValue=="25000"? "AG001" : "AG003"); */
			$("#analysisFrm #analLayerAnalysisGroupCd").val(nowScaleValue=="5000"? "AG003" : "AG001");
			$("#analysisFrm").attr("action", "/popup/analysisDrawPopup.do");
		}
		
		var popupName = createCode(8, 8);
		$("#analysisFrm").attr("target", popupName);
		popup_open('',popupName,797,900);
		$("#analysisFrm").submit();
	}
	
	// 임시 포인트 분석
	function fnAnalysisMoveToFeature(db_x, db_y, gbn) {
		var geomStringSplit = [];
		var geomStringSplitResult = [];
		// tempFeature :: customSingleMap.js 202 Line Number >> 변수 지정
		var geom = new ol.geom.Point([db_x, db_y]);
		
		var format = new ol.format.WKT();// wkt포맷 선언
		var geomString = format.writeGeometry(geom);// 지오메트리 wkt형식으로 변환
		
		if(gbn == "gradient" || gbn == "height"){
		    $("#analysisFrm  #analGhDivision").val(gbn);// 경사도 고도 그리기, 지점분석  파라미터 구분값
		    $("#analysisFrm  #analCoordinate").val(geomString);// 좌표정보
		    $("#analysisFrm  #analFeatureType").val(geom.getType());// 피처타입
		    $("#analysisFrm  #analEpsgCd").val("EPSG:3857");// 좌표계
		    $("#analysisFrm  #analScaleValue").val(nowScaleValue);// 축척
		    $("#analysisFrm  #analLayerAnalysisGroupCd").val("AG007");// 레이어
		                                                                               // 그룹
		    var ghName = createCode(8, 8);
		    $("#analysisFrm  #analAnalysisType").val(gbn);// 분석타입
		    $("#analysisFrm").attr("target", ghName);
		    $("#analysisFrm").attr("action",  "/popup/ghAnalysisDrawPopup.do");
		    popup_open('',ghName,797,900);
		    $("#analysisFrm").submit();
		}else{
			$("#analysisFrm #analCoordinate").val(geomString);// 좌표정보
			$("#analysisFrm #analFeatureType").val(geom.getType());// 피처타입
			$("#analysisFrm #analEpsgCd").val("EPSG:3857");// 좌표계
			$("#analysisFrm #analScaleValue").val(nowScaleValue);// 축척
			$("#analysisFrm #analLayerAnalysisGroupCd").val(nowScaleValue=="25000"? "AG001" : "AG003");// 레이어
																									// 그룹
			var popupName = createCode(8, 8);
			$("#analysisFrm #analAnalysisType").val("draw");// 분석타입
			$("#analysisFrm").attr("target", popupName);
			$("#analysisFrm").attr("action", "/popup/analysisDrawPopup.do");
			popup_open('',popupName,797,900);
			$("#analysisFrm").submit();
		}
	}
	function guideScreenClose() {
		 $("#howLayer2").show(); 
	}
	/* 위치 선택 */
	//선택한 위치 저장용 배열
   let locations = [];
   // 배열 식별을 위한 uid카운터
   window.uidCounter = 0;
   
	$(document).on('click', function(e){
		   if(!$(e.target).closest('.srch').length) {
			   $('.srch_result_div').stop().slideUp();
			   $('.srch').removeClass('over');
			}
		 });
	
	function searchJusoCustom(no) {
		  if ($("#search-juso").val() === '') {
			   alert("지번을 입력해주세요.");
			   return;
			}

        let query = replaceAdmZoneNm($("#search-juso").val());
        let category;
        for (var i = 0; i < query.length; i++) {
           if (query[i].charAt(query[i].length - 1) !== '로' && query[i].charAt(query[i].length - 1) !== '길') {
              category = "parcel";
           } else {
              category = "road";
              break;
           }
        }
        
        let url = createVworldSearchUrl(vWorldSearchUrl, 'search', 'search', 'address', category, no, '1000', $("#search-juso").val());
        
        fnAjax(url, null, "jsonp", function(result) {
           let admZoneList = $(".list-result-box-popup > ul").empty();
           
           totalGun = result.response.record.total;
           $('.result-box-popup span').text(totalGun.toLocaleString());
           /* $('.srch_result_div').slideDown(); */

           if (totalGun == 0) {
              admZoneList.append('<li class="search_result_none">검색결과가 없습니다.</li>');
              return;
           }

           let totalItem = result.response.result.items;
           for (let i = 0; i < totalItem.length; i++) {
              let item = totalItem[i];
              let jusoText = item.address.road ?
              item.address.parcel + ' [' + item.address.road + ']' :
              item.address.parcel;
              admZoneList.append(createCustomJusoList(jusoText, item.point.x, item.point.y, item.id));
            }
         }, error);
      }
	   
      
      function createCustomJusoList(juso, x, y, pnu) {
    	   let tag = $('<li/>').append(
    			'<p style="width:200px;">' + juso + '</p>' +
            '<a href="javascript:void(0)" style="width:41px"; class="add-place" data-x=' + x +' data-y='+y+' data-pnu=' + pnu + '>위치추가</a>'
         );
    	   return tag;
    	}
      $(document).on('click', '.list-result-box-popup .add-place', function(e) {
    	   e.preventDefault();
    	   ++window.uidCounter;
    	   const juso = $(this).closest('li').find('p').text();
    	   const x    = parseFloat(this.dataset.x);
    	   const y    = parseFloat(this.dataset.y);
    	   const pnu  = this.dataset.pnu;
    	   
    	   // 위치추가 클릭시 결과 영역 닫기
    	   e.preventDefault();
         e.stopPropagation();
         closeBox(getBox($(this)));
         
    	   addLocation(juso, x, y, pnu, "search");
    	});
      function addLocation(juso, x, y, pnu, type) {
          
          const uid = window.uidCounter; 
          if(type == 'search'){
             getPolygonFromVWorld(juso, x, y, pnu);
          }
          
           const container = $('.list-box-popup');
           const newEntry = $('<div/>', { class: 'list', 'data-pnu': pnu }).append(
                   $('<div/>', { class: 'list-tit' }).append(
                      $('<p/>', {text: juso}),
                      $('<div/>', { class: 'list-btn-div' }).append(
                         $('<a/>', { 
                            href: 'javascript:', 
                            class: 'move-btn', 
                            text: '이동',
                            'data-uid' : uid,
                            'data-x': x,
                            'data-y': y
                         }),
                         $('<a/>', { 
                            href: 'javascript:', 
                            class: 'delete-btn', 
                            text: '닫기',
                            click: function () {
                               removeLocation(uid);
                               /* $(this).closest('.list').remove(); */
                            }
                         })
                      )
                   ),
                   $('<p/>', { 
                      class: 'ex-txt', text: '※ 해당 위치의 부가설명을 입력해주세요.' }),
                      $('<input/>', {
                         type: 'text',
                         placeholder: '위치의 부가설명을 입력해주세요.',
                         required: true 
                      })
                   );
                container.append(newEntry);

        }
      function getPolygonFromVWorld(juso, x, y, pnu){
          
          const dataUrl =  proxyUrl + 'https://api.vworld.kr/req/data?service=data' +
          '&version=2.0&request=GetFeature&crs=EPSG:3857&format=json' +
          '&data=LP_PA_CBND_BUBUN&attribute=true' +
          '&attrfilter=pnu:=:' + pnu +
          '&apiKey=' + vWorldkeys +
          '&domain=' + vWorldDomain;
                     
          $.getJSON(dataUrl, function (res) {
             const features = res?.response?.result?.featureCollection?.features;
             if (features && features.length > 0){
                const format = new ol.format.GeoJSON();
                const feature = format.readFeature(features[0], {});
                const uid = window.uidCounter;
                feature.set("uid",uid);

                map.getLayers().getArray().find(ele=>ele.get("title")==="opinionLayer").getSource().addFeature(feature)
                
                locations.push({ uid, juso, x, y, pnu, feature });
                moveToMap(uid);
                
             } else {
                alert("폴리곤 정보를 찾을 수 없습니다.");
             }
          });
      }
      function moveToMap(uid) {
          const loc = locations.find(ele => ele.uid === uid);
          if (loc){
           const extent = loc.feature.getGeometry().getExtent();
           
           map.getView().fit(extent, { padding: [50, 50, 50, 50] });
          }
          else{
             alert("선택된 위치로 이동할 수 없습니다 다시 시도해주세요.");
             return;
          }
       }
      function removeLocation(uid) {
    	  
    	   const idx = locations.findIndex(ele => ele.uid === uid);
    	   const targetLayer = map.getLayers().getArray().find(ele=>ele.get("title")==="opinionLayer"); 
    	  
         if(idx !== -1){
        	  
            targetLayer.getSource().removeFeature(locations[idx].feature);
            locations.splice(idx,1);
            $(".list-box-popup .list")[idx].remove();
         } 
      }
      /* 민원발생지역 레이어 On/Off */
      function opinionAndQnaLayerOnOff(){
    	  const opinionAndQnaLayer = map.getLayers().getArray().find(ele=>ele.get("id")=="opinionAndQnaLayer");
    	  opinionAndQnaLayer.setVisible(!opinionAndQnaLayer.getVisible())
      }
      /* 민원발생지역 정보 확인 */
      function toggleSelectMode(){
    	   if(selectMode){
    		   selectMode = false;
    		   //alert("피쳐 선택 모드가 비활성화 되었습니다.");
    	   }else{
    		   selectMode = true;
    		   //alert("피쳐 선택 모드가 활성화 되었습니다. \n민원 세부내역을 확인할 피쳐를 지도화면에서 선택해주세요");
    	   }
      }
      /* 민원 세부내역 확인(parent 페이지를 해당 세부내역 페이지로 이동) */
      function moveParentPage(opinionsecd, opinionseq) {
    	   const opinionSeCd = opinionsecd;
    	   const opinionSeq = opinionseq;
    	   
    	   var hostUrl = $(location).attr("host");
    	   var returnDomain = "";
    	   
    	   if(hostUrl.indexOf("neins") != -1){ // neins 도메인이라면
    		   returnDomain = ecvamNeinsDomain;
    	   }else{ // kei도메인, 개발서버, localhost
    		   returnDomain = ecvamKeiDomain;
    	   }
    	   
    	   let url = "/rhksflwk/board/";
    	   if(opinionSeCd == "CV001"){
    		   url += "qna/qnaView.do?board_seq=";
    	   }else if (opinionSeCd == "CV002"){
    		   url += "opinion/opinionView.do?opin_seq=";
    	   }
    	   url += opinionSeq;

    	   if (window.opener) {
    		    window.opener.postMessage(
    		        { action: "redirect", url: url }, returnDomain  // 부모 페이지 origin 명시
    		    );
    		}
      }
      const BOX_SEL = '.srch-result-div-popup';
      const SCOPE_SEL = '.srch-input';
      function getBox($from) {
          if ($from && $from.length) {
            return $from.closest(SCOPE_SEL).find(BOX_SEL);
          }
          return $(BOX_SEL);
        }
      // 열기: 자연 높이 측정 후 0 -> target
      function openBox($box) {
        if (!$box || !$box.length) return;
        if ($box.is(':visible') && $box.height() > 0) return;

        $box.stop(true, true).css({ display: 'block', height: 'auto' });
        const target = $box.prop('scrollHeight');
        $box.css({ height: 0, overflow: 'hidden' })
            .animate({ height: target }, 200, function () {
              $(this).css({ height: 'auto' });
            });
      }

      // 닫기: 현재 -> 0
      function closeBox($box) {
        if (!$box || !$box.length) return;
        $box.stop(true, true)
            .css({ overflow: 'hidden' })
            .animate({ height: 0 }, 200, function () {
              $(this).css({ display: 'none' });
            });
      }

      // 검색 아이콘 클릭 → 열기
      $(document).on('click', '.srch-ico', function (e) {
        e.preventDefault();
        e.stopPropagation();
        openBox(getBox($(this)));
      });

      // 내부 클릭 시 닫힘 방지
      $(document).on('click', SCOPE_SEL+' input, '+BOX_SEL, function (e) {
        e.stopPropagation();
      });

      

      // 바깥 클릭 시 닫기 (pointerdown + click 보강)
      function outsideHandler(e) {
        const $t = $(e.target);
        const insideScope = $t.closest(SCOPE_SEL).length > 0;
        const insideBox = $t.closest(BOX_SEL).length > 0;
        if (!insideScope && !insideBox) {
          closeBox($(BOX_SEL));
        }
      }
      $(document).on('pointerdown.srchOutside', outsideHandler);
      $(document).on('click.srchOutsideFallback', outsideHandler);

      // ESC 닫기
      $(document).on('keydown', function (e) {
        if (e.key === 'Escape') closeBox($(BOX_SEL));
      });

      // (선택) 다른 라디오/탭 전환 시 닫기
      $(document).on('change', 'input[name="place"]', function () {
        closeBox($(BOX_SEL));
      });
      
</script>

</head>
<body>
	<!-- 건너뛰기 링크 -->
	<div id="skip_nav">
		<ul>
			<li><a href="#header">본문 바로가기</a></li>
			<li><a href="#container">주 메뉴 바로가기</a></li>
		</ul>
	</div> 
	<!-- 전자정부 공식웹사이트 안내영역 -->
	 <!-- <div class="ev_cont">
		<div class="ev_logo">
			<span class="ev_text">이 누리집은 대한민국 공식 전자정부 누리집입니다.</span>
		</div>
	</div>  --> 
	
	<div id="mapAlert"></div>
	
	<div class="click_tempLayer">
		<ul>
			<li class="rc03">
				<a href="javascript:fnAnalysisTempFeature(null, null);">국토환경성평가 분석</a>
			</li>
			<li class="rc04">
				<a href="javascript:fnAnalysisTempFeature('gh', 'gradient');">경사도 분석</a>
			</li>
			<li class="rc05">
				<a href="javascript:fnAnalysisTempFeature('gh', 'height');">표고 분석</a>
			</li>
		</ul>
	</div>
	
	<div class="click_moveToFeature">
		<ul>
			<li id="ecvamPoint" class="rc03">
				<a>국토환경성평가 지점분석</a>
			</li>
			<li id="gradient" class="rc04">
				<a>경사도 지점분석</a>
			</li>
			<li id="height" class="rc05">
				<a>표고 지점분석</a>
			</li>
		</ul>
	</div>
	
	<div class="rclick_layer">
		<div class="tit">
			<span></span>
		</div>
		<ul>            
		<li class="rc09" style="display: none;">
		    <div class="table-container">
		        <table>
		            <tr>
		                <td class="short-border">소유구분</td>
		                <td class="right-align" id="soyu-posesn"><div class="box" id="soyou-legend"></div>-</td>
		            </tr>
		            <tr>
		                <td class="short-border">토지면적</td>
		                <td class="right-align" id="soyu-ar">-</td>
		            </tr>
		            <tr>
		                <td class="short-border">지목</td>
		                <td class="right-align" id="soyu-lndcgr">-</td>
		            </tr>
		            <tr>
		                <td class="short-border">소유권변동일자</td>
		                <td class="right-align" id="soyu-changeDate">-</td>
		            </tr>
		        </table>
		    </div>
			</li>
			<!--  <li class="rc02"><a href="javascript:fnLuris();" onclick="gtag('event', '지도우클릭_토지이용규제정보서비스조회', {'event_category':'지도우클릭_토지이용규제정보서비스조회', 'event_label':'지도우클릭_토지이용규제정보서비스조회'})">토지이용규제정보 서비스 조회</a></li>-->
 			 <li class="rc02">
                <a href="javascript:fnLuris();" onclick="gtag('event', '지도우클릭_토지이용규제정보서비스조회', {'event_category':'지도우클릭_토지이용규제정보서비스조회', 'event_label':'지도우클릭_토지이용규제정보서비스조회'})">토지이용규제정보</a>
                <div class="divider"></div>
                <a href="javascript:void(0);" onclick="gtag('event', '지도우클릭_도시계획열람조회', {'event_category':'지도우클릭_도시계획열람조회', 'event_label':'지도우클릭_도시계획열람조회'}); fnLup('https://www.eum.go.kr/web/cp/cv/cvUpisDet.jsp');">도시계획 열람</a>
            </li>
            <li class="rc08 doyup_down">
            	<a href="javascript:pointDoyup(this);" onclick="gtag('event', '지도우클릭_도엽다운로드', {'event_category':'지도우클릭_도엽다운로드', 'event_label':'지도우클릭_도엽다운로드'})">도엽다운로드</a>
            	<button type="button" onclick="doyupOnOff(this);" title="5000도엽도 켜기">OFF</button>
            </li>
			<li class="rc03"><a href="javascript:getAnalysisInterAction(this);" onclick="gtag('event', '지도우클릭_국토환경성평가지점분석', {'event_category':'지도우클릭_국토환경성평가지점분석', 'event_label':'지도우클릭_국토환경성평가지점분석'})">국토환경성평가 지점분석</a></li>
			<li class="rc07"><a href="javascript:getAnalysisPolygonAction('ecvam');" onclick="gtag('event', '지도우클릭_국토환경성평가지적분석', {'event_category':'지도우클릭_국토환경성평가지적분석', 'event_label':'지도우클릭_국토환경성평가지적분석'})">국토환경성평가 지적분석</a></li>
			<li class="rc04">
				<a href="javascript:;">경사도
					<span id="gradientAnalysisResult" class="rc_span"></span>
					<button type="button" onclick="javascript:getAnalysisPolygonAction('gradient');gtag('event', '지도우클릭_경사도', {'event_category':'지도우클릭_경사도', 'event_label':'지도우클릭_경사도'})" title="경사도 지적분석">분석</button>
				</a> 
			</li>
			<li class="rc05">
				<a href="javascript:;">표고
				<span id="heightAnalysisResult" class="rc_span"></span>
				<button type="button" onclick="javascript:getAnalysisPolygonAction('height');gtag('event', '지도우클릭_표고', {'event_category':'지도우클릭_표고', 'event_label':'지도우클릭_표고'})" title="표고 지적분석">분석</button>
				</a> 
			</li>
			<li class="rc06">
				<a href="javascript:;">가시권분석</a>
				<div class="rc_inp">
					<label for="radius" class="sr-only">가시권반경</label>
					<input type="text" id="radius" title="가시권반경"><sub>m</sub>
					<button type="button" onclick="javascript:fnRadialLineOfSight(); gtag('event', '지도우클릭_가시권분석', {'event_category':'지도우클릭_가시권분석', 'event_label':'지도우클릭_가시권분석'});" title="가시권 분석">분석</button>
				</div>
			</li>
		</ul>
	</div>
   
