// 인기 검색어를 가져와서 동적으로 추가하는 함수 (IE 11 호환)
function loadPopularKeywords(type) {
    var url = "/search/api/ppk.jsp?type=" + type;
    var popularList = document.getElementById("popularList");

    if (!popularList) return;

    // XMLHttpRequest를 사용하여 AJAX 요청
    var xhr = new XMLHttpRequest();
    xhr.open("GET", url, true);
    xhr.onreadystatechange = function () {
        if (xhr.readyState === 4 && xhr.status === 200) {
            try {
                var data = JSON.parse(xhr.responseText);

                // 기존 목록 초기화
                popularList.innerHTML = "";

                // 데이터 순회하며 li 요소 생성 및 추가
                for (var i = 0; i < data.length; i++) {
                    var kwd = data[i].kwd; // 검색어
                    var encodedKwd = encodeURIComponent(kwd); // URL 인코딩

                    var listItem = document.createElement("li");
                    listItem.className = "keyword_item";

                    var anchor = document.createElement("a");
                    anchor.href = "/_ai_/search_sb.html?kwd=" + encodedKwd;
                    anchor.className = "keyword_anchor";

                    var span = document.createElement("span");
                    span.textContent = kwd;

                    anchor.appendChild(span);
                    listItem.appendChild(anchor);
                    popularList.appendChild(listItem);
                }
            } catch (error) {
                console.error("인기 검색어 데이터 처리 중 오류 발생:", error);
            }
        }
    };

    xhr.onerror = function () {
        console.error("인기 검색어를 가져오는 중 네트워크 오류 발생");
    };

    xhr.send();
};

// 페이지 로드 시 실행 (기본 daily로 호출)
document.addEventListener("DOMContentLoaded", function () {
    //loadPopularKeywords("daily");

     loadPopularKeywords("weekly");
});


if(document.getElementById('sel3')){
    document.getElementById('sel3').addEventListener('change', function () {
        const today = new Date();
        const startInput = document.getElementById('cal_start');
        const endInput = document.getElementById('cal_end');
        let startDate = '';
        let endDate = '';
    
        switch (this.value) {
            case 'opt1': // 1주
                startDate = new Date(today);
                startDate.setDate(today.getDate() - 7);
                endDate = today;
                break;
            case 'opt2': // 1개월
                startDate = new Date(today);
                startDate.setMonth(today.getMonth() - 1);
                endDate = today;
                break;
            case 'opt3': // 1년
                startDate = new Date(today);
                startDate.setFullYear(today.getFullYear() - 1);
                endDate = today;
                break;
            default: // 전체
                startDate = '';
                endDate = '';
        }
    
        // 날짜 형식 지정
        function formatDate(date) {
            if (!date) return '';
            const yyyy = date.getFullYear();
            let mm = date.getMonth() + 1; // 월은 0부터 시작하므로 +1
            let dd = date.getDate();
    
            // 두 자릿수로 포맷 (예: 01, 02 등)
            if (mm < 10) mm = '0' + mm;
            if (dd < 10) dd = '0' + dd;
    
            return yyyy + '-' + mm + '-' + dd;
        }
    
        startInput.value = formatDate(startDate);
        endInput.value = formatDate(endDate);
    });
};

</script>
</body>
</html>
