            <div class="search_form">
                <form action="/_ai_/search_sb.html" method="get" onsubmit="return validateSearch()">
                    <fieldset>
                        <legend>검색</legend>
                        <div class="form_top">
                            <div class="query_wrap">
								<!-- 20260930 -->
								<style>
									.search .search_form .search_input:has(.search_query){padding-left:210px;}
									.search .search_form .search_input:has(.search_query) .search_query{padding-left:20px;}

									.new-search-option-toggle{position: absolute;top: 50%;left: 8px;transform: translateY(-50%);flex:0 0 auto;background: #fafafa;border: 1px solid #dfdfdf;border-radius: 53px;margin-right: 20px;z-index: 21;}
									.new-search-option-toggle::before{display:block;content:"";position:absolute;left: -1px;top: -1px;bottom: -1px;width: 103px;background: linear-gradient(to right, #489ef2, #12418b);transform: translateX(0px);transition: 0.3s;border-radius: 53px;}
									.new-search-option-toggle.on::before{transform: translateX(82px);}
									.new-search-option-toggle::after{display:block;content:"";position:absolute;right: -20px;top:50%;transform:translateY(-50%);width: 1px;height: 30px;background: #dfdfdf;}

									.new-search-option-toggle{flex:0 0 auto;}
									.switch-wrapper{position: relative;display:flex;align-items:center;width: 184px;}
									.switch-wrapper .switch-label{width: 45%;transition: 0.3s;}
									.switch-wrapper .switch-label.on{width: 55%;}
									.switch-status{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);margin:-1px}
									.switch-label input{opacity:0;position: absolute;}
									.switch-label input + label{width: 100%;height: 63px;display: flex;align-items: center;justify-content: center;font-size: 18px;color: #000;}
									.switch-label.on label{color:#fff;}
									.switch-label label::before{display:block;content:"";display:inline-block;width:26px;height:26px;margin-right: 6px;}
									.option-general label::before{background:url(https://www.sb.go.kr/site/www/images/main/icon_general_off.png) no-repeat;}
									.option-general.on label::before{background: url(https://www.sb.go.kr/site/www/images/main/icon_general.png) no-repeat;}
									.option-ai label::before{background:url(https://www.sb.go.kr/site/www/images/main/icon_ai_off.png) no-repeat;}
									.option-ai.on label::before{background:url(https://www.sb.go.kr/site/www/images/main/icon_ai.png) no-repeat;}

									.search-status{display: none !important;position:absolute;left:-10px;top:50%;transform:translateY(-50%);width:45px;height:45px;background:linear-gradient(120deg,#279cff,#0a266b);color:#fff;z-index:11;text-align:center;display:flex;align-items:center;justify-content:center;border-radius:50%}
									@media (max-width: 1000px){
										.search .search_fieldset{border-bottom:0;}
										.search .search_submit{left:auto;right:0;}
										.search .search_query{padding-right:55px;padding-left: 10px;border: 1px solid #999;border-radius: 10px;}
										.search .search_form .search_input:has(.search_query){padding-left:140px;}
										.search .search_form .search_input:has(.search_query) .search_query {padding-left: 10px;border: 0;}


										.new-search-option-toggle{margin-right:10px;}
										.switch-wrapper{width: 120px;}
										.new-search-option-toggle::after{right:-11px;}
										.new-search-option-toggle::before{width:55%;}
										.new-search-option-toggle.on::before{transform: translateX(56px);}
										.switch-label input + label{font-size:14px;height: 43px;}
										.switch-label label::before{margin-right:3px;width:20px;height:20px;background-size: 100% 100% !important;}
									}
									@media screen and (max-width:640px){
										.switch-label input + label{height: 35px;}
										.search .search_hide{top:8px;}
										.search.active .search_panel{padding-bottom: 20px;padding-top: 25px;}
									}
									@media screen and (max-width:375px){
										.search .search_form .search_input:has(.search_query){padding-left:120px;}

										.switch-wrapper{width: 100px;}
										.new-search-option-toggle.on::before{transform: translateX(46px);}
										.switch-label label::before{margin-right:0px;width: 15px;height: 15px;}
										.search .search_input{padding-left:125px;}
									}
								</style>
								<script>
									$(function () {
										const searchBtn = $('.search_submit');
										const searchIpt = $('.search_query');
										const originalPlaceholder = searchIpt.attr("placeholder");
										// 전역 상태: false=일반검색, true=AI검색
										let globalIsAI = false;

										/**
										 * 전체 UI 갱신: 두 그룹 모두 동일한 상태로 렌더링
										 */
										function renderAllUI(isAI) {
											globalIsAI = isAI;

											// ===== 그룹1 업데이트 (switch-input) =====
											$('.switch-input#option-general').prop('checked', !isAI);
											$('.switch-input#option-ai').prop('checked', isAI);
											$('.switch-input').attr('aria-checked', isAI ? 'true' : 'false');

											// ===== 그룹2 업데이트 (switch-input2) =====
											$('.switch-input2#option-general2').prop('checked', !isAI);
											$('.switch-input2#option-ai2').prop('checked', isAI);
											$('.switch-input2').attr('aria-checked', isAI ? 'true' : 'false');

											// 두 그룹 공통 클래스 토글
											const $toggles = $('.new-search-option-toggle');
											const $generalLabels = $('.switch-label.option-general');
											const $aiLabels = $('.switch-label.option-ai');
											const $statusTexts = $('.switch-status');

											if (isAI) {
												$generalLabels.removeClass('on');
												$aiLabels.addClass('on');
												$toggles.addClass('on');
												$statusTexts.text('현재 선택: AI 검색');

												// 768px 이하에서는 placeholder 변경
												searchIpt.attr(
													'placeholder',
													$(window).width() <= 768 ? 'AI 검색' : 'AI와 대화하듯 검색해보세요'
												);
												searchBtn.attr('aria-label', '입력한 검색어로 ai 검색 진행하기');
											} else {
												$generalLabels.addClass('on');
												$aiLabels.removeClass('on');
												$toggles.removeClass('on');
												$statusTexts.text('현재 선택: 일반 검색');

												// 768px 이하에서는 placeholder 변경
												searchIpt.attr(
													'placeholder',
													$(window).width() <= 768 ? '키워드 검색' : '키워드를 입력하세요'
												);

												searchBtn.attr('aria-label', '입력한 검색어로 일반 검색 진행하기');
											}
											changeSearch();
										}

										$(window).on('resize', function() {
											renderAllUI(globalIsAI);
										});

										// 그룹1 라디오 변경
										$(document).on('change', '.switch-input', function () {
											const isAI = this.id === 'option-ai';
											renderAllUI(isAI);
										});

										// 그룹2 라디오 변경
										$(document).on('change', '.switch-input2', function () {
											const isAI = this.id === 'option-ai2';
											renderAllUI(isAI);
										});

										// 초기 렌더
										renderAllUI(false);
										
										$("#option-ai").click();
									});
									
									var changeSearch = function(){
										if(!$(".switch-input").prop("checked")){
											var aList = $("a[href^='/search/search.jsp']");
											for(var idx=0; idx<aList.length; idx++){
												var a = $(aList[idx]);
												a.attr("href", a.attr("href").replace("/search/search.jsp", "/_ai_/search_sb.html"));
											}
											var formList = $("form[action^='/search/search.jsp']");
											for(var idx=0; idx<formList.length; idx++){
												var form = $(formList[idx]);
												form.attr("action", form.attr("action").replace("/search/search.jsp", "/_ai_/search_sb.html"));
											}
									   }else {
											var aList = $("a[href^='/_ai_/search_sb.html']");
											for(var idx=0; idx<aList.length; idx++){
												var a = $(aList[idx]);
												a.attr("href", a.attr("href").replace("/_ai_/search_sb.html", "/search/search.jsp"));
											}
											var formList = $("form[action^='/_ai_/search_sb.html']");
											for(var idx=0; idx<formList.length; idx++){
												var form = $(formList[idx]);
												form.attr("action", form.attr("action").replace("/_ai_/search_sb.html", "/search/search.jsp"));
											}
									   }
									}
								</script>
								<div class="new-search-option-toggle">
									<fieldset class="preferences">
										<legend class="legend">검색 설정</legend>
										<div class="switch-wrapper">
											<!-- 일반 검색 -->
											<span class="switch-label option-general on">
												<input type="radio" name="switch-input" id="option-general" class="switch-input" aria-checked="false">
												<label for="option-general">일반</label>
											</span>
											<!-- AI 검색 -->
											<span class="switch-label option-ai">
												<input type="radio" name="switch-input" id="option-ai" class="switch-input" aria-checked="false">
												<label for="option-ai">AI</label>
