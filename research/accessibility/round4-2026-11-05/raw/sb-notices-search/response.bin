<script>
    function fnKakaoSmsSendM(){
        if($("#phoneNum1").val() == ''){
            alert("휴대폰 번호를 입력하세요.");
            $("#phoneNum1").focus();
            return;
        }

        var phoneNum = $("#phoneNum1").val().replace(/[^-0-9]/g, '');

        if(phoneNum.length != 11){
             alert("정확한 휴대폰 번호를 입력하여 주세요.");
             return;
        }

        $.ajax({
            url:"./smsKakaoSendAjax.do",
            data:{"phoneNum":phoneNum},
            type:"post",
            dataType:"text",
            success:function(data, status){
              if(data == 'SUCCESS'){
                 alert('성북구청 채널친구 추가 안내문이 전송되었습니다.');
              }
              if(data == 'FAILED'){
               //alert('FAILED');
              }

            },
            error:function(xhr, stat, res){
                alert(xhr.reponseText + "\n" + status + "\n" + res);
            }
        });
    }

    function fnKakaoSmsSend(){
        if($("#phoneNum").val() == ''){
            alert("휴대폰 번호를 입력하세요.");
            $("#phoneNum").focus();
            return;
        }
        var phoneNum = $("#phoneNum").val().replace(/[^-0-9]/g, '');
        if(phoneNum.length != 11){
        	 alert("정확한 휴대폰 번호를 입력하여 주세요.");
        	 return;
        }
        $.ajax({
            url:"./smsKakaoSendAjax.do",
            data:{"phoneNum":phoneNum},
            type:"post",
            dataType:"json",
            success:function(data, status){

              if(data.result == 'SUCCESS'){
            	  alert('성북구청 채널친구 추가 안내문이 전송되었습니다.');
              }
              if(data.result == 'FAILED'){
               //alert('FAILED');
              }

            },
            error:function(xhr, stat, res){
                alert(xhr.reponseText + "\n" + status + "\n" + res);
            }
        });
    }
    var smsUrl = "";
    $(document).ready(function(){
        var beParam = getSmsParamsByName("fn_smsSubmit");
        if(beParam != ""){
	        var param_r1 = beParam.param_r1;
	        var param_r2 = beParam.param_r2;
	        var param_r3 = beParam.param_r3;
	        smsUrl = "/api/niceSubmitForm.do?param_r1="+param_r1+"&param_r2="+param_r2+"&param_r3="+param_r3;
	        var rUrl = "rUrl="+location.pathname + location.search;
	        rUrl = rUrl.replaceAll("&", "||");
	        rUrl = "&" + rUrl;
	        var sUrl = "";
	        var paramList = location.search.replace("?", "").split("&");
	        for(var idx=0; idx<paramList.length; idx++){
	            var param = paramList[idx];
	            var paramName = param.split("=")[0];
	            var paramValue = param.split("=")[1];
	            if(paramName == "key"){
	            	if(paramValue == "8161") {
	         			sUrl = "&sUrl=/www/eventRegistSucc.do?key=8161";
	            	}else if(paramValue == "5819"){
	            		sUrl = "&sUrl=/www/sbSmsWebReqestSucc.do?key=5819";
	            	}
	            }
	        }
	        if(sUrl != ""){
	        	rUrl = "";
	        }
	        smsUrl += rUrl;
	        smsUrl += sUrl;
	        //'/api/niceSubmitForm.do?mode=M&param_r1=&param_r2=useList&rUrl=/www/eventList.do?key=6376&sUrl=/www/eventRegistSucc.do?key=6376'
	        		
	        fn_smsSubmit = function(){ 
	        	console.log("newFunction");
		        window.open(smsUrl + "&mode=M", 'niceForm', 'width=430, height=560, resizable=0, scrollbars=no, status=0, titlebar=0, toolbar=0, left=435, top=250');
		    }
	        
	       	fn_ipinSubmit = function(){ 
	        	console.log("newFunction");
		        window.open(smsUrl + "&mode=I", 'niceForm', 'width=430, height=560, resizable=0, scrollbars=no, status=0, titlebar=0, toolbar=0, left=435, top=250');
		    }
        }
    });
    function getSmsParamsByName(funcName) {
        const targetFunc = window[funcName];
        if (typeof targetFunc !== 'function') {
            console.error(`함수 ''을(를) 찾을 수 없습니다.`);
            return "";
        }

        const code = targetFunc.toString();
        const params = {
            param_r1: '',
            param_r2: '',
            param_r3: ''
        };

        for (let i = 1; i <= 3; i++) {
            const key = "param_r" + i; // 정확히 param_r1, param_r2, param_r3 타겟팅
            let val = "";

            // 1. 자바스크립트 직접 대입 형식 탐색 (예: param_r1.value = 'LOGIN')
            const jsTarget = key + ".value";
            let idx = code.indexOf(jsTarget);
            if (idx !== -1) {
                let eqIdx = code.indexOf("=", idx);
                if (eqIdx !== -1) {
                    let sub = code.substring(eqIdx + 1).trim();
                    if (sub.length > 0) {
                        let quoteChar = sub[0];
                        if (quoteChar === "'" || quoteChar === '"' || quoteChar === '`') {
                            let endQuoteIdx = sub.indexOf(quoteChar, 1);
                            if (endQuoteIdx !== -1) {
                                val = sub.substring(1, endQuoteIdx);
                            }
                        } else {
                            let semiIdx = sub.indexOf(";");
                            val = semiIdx !== -1 ? sub.substring(0, semiIdx).trim() : sub;
                        }
                    }
                }
            }

            // 2. HTML input 태그 형식 탐색 (예: name="param_r1" ... value="...")
            if (!val) {
                let searchIndex = 0;
                while (true) {
                    idx = code.indexOf(key, searchIndex);
                    if (idx === -1) break;

                    // 다음 문자가 숫자인지 확인 (예: param_r10 같은 다른 변수 혼동 방지)
                    let nextChar = code[idx + key.length];
                    if (nextChar >= '0' && nextChar <= '9') {
                        searchIndex = idx + key.length;
                        continue;
                    }

                    // 키 앞쪽에 name 속성이 포함되어 있는지 확인
                    let precedingText = code.substring(Math.max(0, idx - 20), idx);
                    if (precedingText.includes("name=")) {
                        let subAfter = code.substring(idx);
                        let valKeywordIdx = subAfter.indexOf("value=");
                        if (valKeywordIdx !== -1 && valKeywordIdx < 60) {
                            let quotePart = subAfter.substring(valKeywordIdx + 6).trim();
                            if (quotePart.length > 0) {
                                let qChar = quotePart[0];
                                if (qChar === "'" || qChar === '"') {
                                    let qEnd = quotePart.indexOf(qChar, 1);
                                    if (qEnd !== -1) {
                                        val = quotePart.substring(1, qEnd);
                                        break;
                                    }
                                }
                            }
                        }
                    }
                    searchIndex = idx + key.length;
                }
            }

            params[key] = val.trim();
        }

        return params;
    }
    //html 페이지 로그인 확인용
    function isLogin(){
    	if("false" == "true"){
    		return true;
    	}else {
    		return false;
    	}
    }
    </script>


