{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "ignoreCommand": "git log -1 --pretty=%B | grep -Fq '[skip vercel]'",
  "outputDirectory": "donghaeng-nav/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {"source": "/api/transit/walk-review", "destination": "/api/index?route=transit/walk-review"},
    {"source": "/api/city/coverage", "destination": "/api/index?route=city/coverage"},
    {"source": "/api/routes/city-walk", "destination": "/api/index?route=routes/city-walk"},
    {"source": "/api/coverage", "destination": "/api/index?route=coverage"},
    {"source": "/api/features", "destination": "/api/index?route=features"},
    {"source": "/api/places", "destination": "/api/index?route=places"},
    {"source": "/api/routes/walk", "destination": "/api/index?route=routes/walk"},
    {"source": "/api/routes/transit", "destination": "/api/index?route=routes/transit"},
    {"source": "/api/journeys", "destination": "/api/index?route=journeys"},
    {"source": "/api/transit/status", "destination": "/api/index?route=transit/status"},
    {"source": "/app", "destination": "/index.html"},
    {"source": "/app/:path*", "destination": "/:path*"},
    {"source": "/api/status", "destination": "/api/index?route=status"},
    {"source": "/api/analyze-condition", "destination": "/api/index?route=analyze-condition"},
    {"source": "/api/select-route", "destination": "/api/index?route=select-route"}
  ]
}
